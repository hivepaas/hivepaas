{
  "command":"mongosh ${CMD_CONN_ARGS} ${CMD_OPTS_ARGS}",
  "link":"https://www.mongodb.com/docs/manual/reference/method/db.createUser/",
  "desc":"Create a new user with readWrite role in MongoDB database",
  "envVars":[],
  "argGroups":[
    {
      "enabled":true,
      "exportEnv":"CMD_CONN_ARGS",
      "separator":"=",
      "args":[
        {"use":true, "name":"--host", "value":"localhost"},
        {"use":true, "name":"--port", "value":"${HIVEPAAS_PORT}"},
        {"use":true, "name":"--username", "value":"${HIVEPAAS_USER}"},
        {"use":true, "name":"--password", "value":"${HIVEPAAS_PASSWORD}"},
        {"use":true, "name":"--authenticationDatabase", "value":"admin"},
        {"use":true, "name":"--quiet"}
      ]
    },
    {
      "enabled":true,
      "exportEnv":"CMD_OPTS_ARGS",
      "separator":" ",
      "args":[
        {"use":true, "name":"--eval", "value":"db.getSiblingDB('${HIVEPAAS_TARGET_DB}').createUser({user: '${HIVEPAAS_TARGET_USER}', pwd: '${HIVEPAAS_TARGET_PASSWORD}', roles: [{role: 'readWrite', db: '${HIVEPAAS_TARGET_DB}'}]});"}
      ]
    }
  ]
}
