+                                        <Field className="w-auto">
+                                            <Input
+                                                {...retryDelay}
+                                                placeholder="delay, 1m"
+                                                className="w-24"
+                                                aria-invalid={retryDelayState.invalid}
+                                                disabled={readOnly}
+                                            />
+                                            <FieldError errors={[errors.retryDelay]} />
+                                        </Field>
+                                    </div>
+                                </InfoBlock>
