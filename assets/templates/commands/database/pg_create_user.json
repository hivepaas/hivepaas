{
  "command":"psql ${CMD_CONN_ARGS} ${CMD_OPTS_ARGS}",
  "link":"https://www.postgresql.org/docs/current/sql-createuser.html",
  "desc":"Create a new PostgreSQL user role and grant privileges on the database",
  "envVars":[
    {"k":"PGPASSWORD", "v":"${HIVEPAAS_PASSWORD}"}
  ],
  "argGroups":[
    {
      "enabled":true,
      "exportEnv":"CMD_CONN_ARGS",
      "separator":"=",
      "args":[
        {"use":true, "name":"--host", "value":"localhost"},
        {"use":true, "name":"--port", "value":"${HIVEPAAS_PORT}"},
        {"use":true, "name":"--username", "value":"${HIVEPAAS_USER}"},
        {"use":true, "name":"--dbname", "value":"postgres"},
        {"use":true, "name":"--no-password"}
      ]
    },
    {
      "enabled":true,
      "exportEnv":"CMD_OPTS_ARGS",
      "separator":" ",
      "args":[
        {"use":true, "name":"-c", "value":"CREATE USER \"${HIVEPAAS_TARGET_USER}\" WITH ENCRYPTED PASSWORD '${HIVEPAAS_TARGET_PASSWORD}'; GRANT ALL PRIVILEGES ON DATABASE \"${HIVEPAAS_TARGET_DB}\" TO \"${HIVEPAAS_TARGET_USER}\";"}
      ]
    }
  ]
}
