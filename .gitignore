!/.cursor/rules/*.mdc
/.run
/mocks
/build/*
/vendor
/test-results
/temp
/.temp
/tmp
/dist-dashboard/*
/.appdata
/.gocache
.env
.envrc
.DS_Store
# Release signing keys belong offline, never in the repo.
*.key
