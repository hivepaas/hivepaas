+  // repo_path is the repository's directory, as the agent sees the host.
+  string repo_path = 1;
+  string repo_password = 2;
+  // username is the user its clients log in as, user@host.
+  string username = 3;
+  string user_password = 4;
+  // listen_host is the agent's address, as the caller reached it.
+  string listen_host = 5;
+}
+
+message RepoServerResp {
+  int32 port = 1;
+  // cert_fingerprint is the SHA-256 fingerprint of the server's certificate.
+  string cert_fingerprint = 2;
+}
