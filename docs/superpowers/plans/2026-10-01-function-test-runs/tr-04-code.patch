+  // FunctionTestRun calls a function once on the agent's node: its libraries'
+  // image built or found there, its code and the request in a throwaway
+  // container. See service/functionservice/functiontest.
+  rpc FunctionTestRun(FunctionTestRunReq) returns (FunctionTestRunResp);
+}
