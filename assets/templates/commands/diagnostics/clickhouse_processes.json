{
  "command":"clickhouse-client ${CMD_CONN_ARGS} ${CMD_OPTS_ARGS}",
  "link":"https://clickhouse.com/docs/en/operations/system-tables/processes",
  "desc":"Show currently running queries and resource usage in ClickHouse",
  "envVars":[
    {"k":"CLICKHOUSE_PASSWORD", "v":"${HIVEPAAS_PASSWORD}"}
  ],
  "argGroups":[
    {
      "enabled":true,
      "exportEnv":"CMD_CONN_ARGS",
      "separator":"=",
      "args":[
        {"use":true, "name":"--host", "value":"localhost"},
        {"use":true, "name":"--port", "value":"${HIVEPAAS_PORT}"},
        {"use":true, "name":"--user", "value":"${HIVEPAAS_USER}"}
      ]
    },
    {
      "enabled":true,
      "exportEnv":"CMD_OPTS_ARGS",
      "separator":" ",
      "args":[
        {"use":true, "name":"--query", "value":"SELECT query_id, user, elapsed, read_rows, read_bytes, memory_usage, query FROM system.processes ORDER BY elapsed DESC;"}
      ]
    }
  ]
}
