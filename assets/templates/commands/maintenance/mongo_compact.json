{
  "command":"mongosh ${CMD_CONN_ARGS} ${CMD_OPTS_ARGS}",
  "link":"https://www.mongodb.com/docs/manual/reference/command/compact/",
  "desc":"Defragment collection storage and rebuild indexes in MongoDB",
  "envVars":[],
  "argGroups":[
    {
      "enabled":true,
      "exportEnv":"CMD_CONN_ARGS",
      "separator":"=",
      "args":[
        {"use":true, "name":"--host", "value":"localhost"},
        {"use":true, "name":"--port", "value":"${HIVEPAAS_PORT}"},
        {"use":true, "name":"--username", "value":"${HIVEPAAS_USER}"},
        {"use":true, "name":"--password", "value":"${HIVEPAAS_PASSWORD}"},
        {"use":true, "name":"--authenticationDatabase", "value":"admin"},
        {"use":true, "name":"--quiet"}
      ]
    },
    {
      "enabled":true,
      "exportEnv":"CMD_OPTS_ARGS",
      "separator":" ",
      "args":[
        {"use":true, "name":"--eval", "value":"db.getSiblingDB('${HIVEPAAS_DATABASE}').runCommand({compact: '${HIVEPAAS_COLLECTION}'})"}
      ]
    }
  ]
}
