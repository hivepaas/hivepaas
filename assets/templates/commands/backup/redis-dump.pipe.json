{
  "command":"redis-cli ${CMD_CONN_ARGS} ${CMD_OPTS_ARGS}",
  "link":"https://redis.io/docs/latest/develop/connect/cli/",
  "desc":"Dump Redis dataset to stdout as an RDB snapshot binary stream",
  "envVars":[
    {"k":"REDISCLI_AUTH", "v":"${HIVEPAAS_PASSWORD}"}
  ],
  "argGroups":[
    {
      "enabled":true,
      "exportEnv":"CMD_CONN_ARGS",
      "separator":" ",
      "args":[
        {"use":true, "name":"-h", "value":"localhost"},
        {"use":true, "name":"-p", "value":"${HIVEPAAS_PORT}"},
        {"use":true, "name":"--no-auth-warning"}
      ]
    },
    {
      "enabled":true,
      "exportEnv":"CMD_OPTS_ARGS",
      "separator":" ",
      "args":[
        {"use":true, "name":"--rdb", "value":"-"}
      ]
    }
  ]
}
