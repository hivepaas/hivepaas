# The HivePaaS agent image of a release. As deployment/release/Dockerfile: a
# production build, kopia's image pinned by digest, and only the configuration
# files a release runs with.

# kopia, the backup engine: built from source into an image of its own
# (deployment/kopia/Dockerfile) and pinned by digest - the same one in the
# release's and the dev's Dockerfiles, app and agent (docs/RELEASING.md).
ARG KOPIA_IMAGE=ghcr.io/hivepaas/kopia:0.23.1-1@sha256:c00e0f5a45e02f131b68b89df7b1aeebafa2621db3a9fd6bb68ab0236d3d7d18
FROM ${KOPIA_IMAGE} AS kopia

############################################################
# Build agent
FROM golang:1.27-alpine AS builder

RUN apk update && \
    apk add --no-cache -U tzdata make git build-base ca-certificates && \
    rm -rf /var/cache/apk/*

ENV CGO_ENABLED=0

WORKDIR /build

COPY . .

RUN make mod
RUN make build-agent-prod

############################################################
# The image
FROM alpine:3.24
ARG VERSION
ARG REVISION

LABEL org.opencontainers.image.title="HivePaaS agent" \
      org.opencontainers.image.source="https://github.com/hivepaas/hivepaas" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}"

WORKDIR /hivepaas

RUN apk update && \
    apk add --no-cache ca-certificates make openssl postgresql-client git git-lfs openssh-client rsync zstd lz4 docker-cli docker-cli-buildx && \
    git lfs install --system && \
    rm -rf /var/cache/apk/*

# kopia, the backup engine, and its license.
COPY --from=kopia /kopia /usr/local/bin/kopia
COPY --from=kopia /LICENSE /usr/share/licenses/kopia/LICENSE
RUN kopia --version

COPY --from=builder /build/hivepaas-agent .
COPY --from=builder /build/config/config.production.toml /build/config/config.beta.toml ./config/

CMD ["./hivepaas-agent"]
