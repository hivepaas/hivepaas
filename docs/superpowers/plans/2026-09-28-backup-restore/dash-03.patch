+                        {problems.length > 0 && (
+                            <ul className="mt-2 list-disc pl-5 text-xs text-muted-foreground">
+                                {problems.map(problem => (
+                                    <li key={problem}>{problem}</li>
+                                ))}
+                            </ul>
+                        )}
+                    </Row>
+                )}
+            </div>
+
+            <SheetFooter className="flex-row justify-end gap-2">
+                <Button
