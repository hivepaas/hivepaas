{
  "command":"clickhouse-client ${CMD_CONN_ARGS} ${CMD_OPTS_ARGS}",
  "link":"https://clickhouse.com/docs/en/interfaces/formats#parquet",
  "desc":"Export table data from ClickHouse into Parquet format",
  "envVars":[
    {"k":"CLICKHOUSE_PASSWORD", "v":"${HIVEPAAS_PASSWORD}"}
  ],
  "argGroups":[
    {
      "enabled":true,
      "exportEnv":"CMD_CONN_ARGS",
      "separator":"=",
      "args":[
        {"use":true, "name":"--host", "value":"localhost"},
        {"use":true, "name":"--port", "value":"${HIVEPAAS_PORT}"},
        {"use":true, "name":"--user", "value":"${HIVEPAAS_USER}"}
      ]
    },
    {
      "enabled":true,
      "exportEnv":"CMD_OPTS_ARGS",
      "separator":" ",
      "args":[
        {"use":true, "name":"--query", "value":"SELECT * FROM ${HIVEPAAS_TABLE} INTO OUTFILE '/tmp/${HIVEPAAS_TABLE}.parquet' FORMAT Parquet;"}
      ]
    }
  ]
}
