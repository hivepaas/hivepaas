{
  "command":"curl ${CMD_CONN_ARGS} ${CMD_OPTS_ARGS}",
  "link":"https://www.elastic.co/guide/en/elasticsearch/reference/current/cluster-health.html",
  "desc":"Check Elasticsearch cluster health status and active shards",
  "envVars":[],
  "argGroups":[
    {
      "enabled":true,
      "exportEnv":"CMD_CONN_ARGS",
      "separator":" ",
      "args":[
        {"use":true, "name":"-s"},
        {"use":true, "name":"-u", "value":"${HIVEPAAS_USER}:${HIVEPAAS_PASSWORD}"}
      ]
    },
    {
      "enabled":true,
      "exportEnv":"CMD_OPTS_ARGS",
      "separator":" ",
      "args":[
        {"use":true, "name":"http://localhost:${HIVEPAAS_PORT}/_cluster/health?pretty"}
      ]
    }
  ]
}
