{
  "command":"pgbench ${CMD_CONN_ARGS} ${CMD_OPTS_ARGS}",
  "link":"https://www.postgresql.org/docs/current/pgbench.html",
  "desc":"Initialize the standard pgbench benchmark schema and scale test data",
  "envVars":[
    {"k":"PGPASSWORD", "v":"${HIVEPAAS_PASSWORD}"}
  ],
  "argGroups":[
    {
      "enabled":true,
      "exportEnv":"CMD_CONN_ARGS",
      "separator":"=",
      "args":[
        {"use":true, "name":"--host", "value":"localhost"},
        {"use":true, "name":"--port", "value":"${HIVEPAAS_PORT}"},
        {"use":true, "name":"--username", "value":"${HIVEPAAS_USER}"},
        {"use":true, "name":"--no-password"}
      ]
    },
    {
      "enabled":true,
      "exportEnv":"CMD_OPTS_ARGS",
      "separator":" ",
      "args":[
        {"use":true, "name":"-i"},
        {"use":true, "name":"-s", "value":"10"},
        {"use":true, "name":"${HIVEPAAS_DATABASE}"}
      ]
    }
  ]
}
