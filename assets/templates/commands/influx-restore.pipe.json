{
  "command":"sh -c \"rm -rf /tmp/influx_bak && mkdir -p /tmp/influx_bak && tar -xzf - -C /tmp/influx_bak && influx restore /tmp/influx_bak ${CMD_CONN_ARGS} ${CMD_OPTS_ARGS} && rm -rf /tmp/influx_bak\"",
  "link":"https://docs.influxdata.com/influxdb/v2/reference/cli/influx/restore/",
  "desc":"Extract stream from stdin into a temp directory and restore into InfluxDB",
  "envVars":[
    {"k":"INFLUX_TOKEN", "v":"${HIVEPAAS_PASSWORD}"}
  ],
  "argGroups":[
    {
      "enabled":true,
      "exportEnv":"CMD_CONN_ARGS",
      "separator":" ",
      "args":[
        {"use":true, "name":"--host", "value":"http://localhost:${HIVEPAAS_PORT}"},
        {"use":true, "name":"--org", "value":"${HIVEPAAS_USER}"}
      ]
    },
    {
      "enabled":true,
      "exportEnv":"CMD_OPTS_ARGS",
      "separator":" ",
      "args":[
        {"use":true, "name":"--full"},
        {"use":false, "name":"--token", "value":"${HIVEPAAS_PASSWORD}"}
      ]
    }
  ]
}
