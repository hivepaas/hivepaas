{
  "command":"mongosh ${CMD_CONN_ARGS} ${CMD_OPTS_ARGS}",
  "link":"https://www.mongodb.com/docs/manual/reference/program/mongosh/",
  "desc":"Measure batch insert throughput and response latency in MongoDB",
  "envVars":[],
  "argGroups":[
    {
      "enabled":true,
      "exportEnv":"CMD_CONN_ARGS",
      "separator":"=",
      "args":[
        {"use":true, "name":"--host", "value":"localhost"},
        {"use":true, "name":"--port", "value":"${HIVEPAAS_PORT}"},
        {"use":true, "name":"--username", "value":"${HIVEPAAS_USER}"},
        {"use":true, "name":"--password", "value":"${HIVEPAAS_PASSWORD}"},
        {"use":true, "name":"--authenticationDatabase", "value":"admin"},
        {"use":true, "name":"--quiet"}
      ]
    },
    {
      "enabled":true,
      "exportEnv":"CMD_OPTS_ARGS",
      "separator":" ",
      "args":[
        {"use":true, "name":"--eval", "value":"const t0 = Date.now(); for (let i = 0; i < 5000; i++) db.__bench.insertOne({i, d: new Date()}); print('Time ms:', Date.now() - t0); db.__bench.drop();"}
      ]
    }
  ]
}
