diff --git a/hivepaas/serve/config.go b/hivepaas/serve/config.go
new file mode 100644
index 0000000..fdc0482
--- /dev/null
+++ b/hivepaas/serve/config.go
@@ -0,0 +1,69 @@
+package serve
+
+import (
+	"errors"
+	"fmt"
+	"strconv"
+	"time"
+)
+
+// The contract's defaults.
+const (
+	defaultPort           = 8080
+	defaultTimeoutMs      = 30000
+	defaultMaxConcurrency = 16
+	defaultMaxBodySize    = 6 << 20
+)
+
+var errNotPositive = errors.New("not a positive whole number")
+
+// Config is the runtime's limits, read from the environment.
+type Config struct {
+	// Port is where serve listens (HP_FN_PORT).
+	Port int
+	// Timeout is how long one call may take (HP_FN_TIMEOUT_MS).
+	Timeout time.Duration
+	// MaxConcurrency is how many calls run at once (HP_FN_MAX_CONCURRENCY).
+	MaxConcurrency int
+	// MaxBodySize bounds a request's body and a response's (HP_FN_MAX_BODY_SIZE).
+	MaxBodySize int64
+}
+
+// LoadConfig reads the configuration with getenv, the contract's defaults
+// filling what is not set.
+func LoadConfig(getenv func(string) string) (Config, error) {
+	port, err := positive(getenv, "HP_FN_PORT", defaultPort)
+	if err != nil {
+		return Config{}, err
+	}
+	timeoutMs, err := positive(getenv, "HP_FN_TIMEOUT_MS", defaultTimeoutMs)
+	if err != nil {
+		return Config{}, err
+	}
+	concurrency, err := positive(getenv, "HP_FN_MAX_CONCURRENCY", defaultMaxConcurrency)
+	if err != nil {
+		return Config{}, err
+	}
+	bodySize, err := positive(getenv, "HP_FN_MAX_BODY_SIZE", defaultMaxBodySize)
+	if err != nil {
+		return Config{}, err
+	}
+	return Config{
+		Port:           int(port),
+		Timeout:        time.Duration(timeoutMs) * time.Millisecond,
+		MaxConcurrency: int(concurrency),
+		MaxBodySize:    bodySize,
+	}, nil
+}
+
+func positive(getenv func(string) string, name string, fallback int64) (int64, error) {
+	value := getenv(name)
+	if value == "" {
+		return fallback, nil
+	}
+	n, err := strconv.ParseInt(value, 10, 32)
+	if err != nil || n <= 0 {
+		return 0, fmt.Errorf("%s is %q: %w", name, value, errNotPositive)
+	}
+	return n, nil
+}
diff --git a/hivepaas/serve/invoke.go b/hivepaas/serve/invoke.go
new file mode 100644
index 0000000..1a248c0
--- /dev/null
+++ b/hivepaas/serve/invoke.go
@@ -0,0 +1,94 @@
+package serve
+
+import (
+	"context"
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"strings"
+
+	"github.com/hivepaas/function-runtimes/hivepaas"
+)
+
+// resultMarker starts the line that carries an invoke's result.
+const resultMarker = "#hivepaas-result "
+
+type invokeRequest struct {
+	Method  string              `json:"method"`
+	Path    string              `json:"path"`
+	Query   map[string][]string `json:"query"`
+	Headers map[string][]string `json:"headers"`
+	Body    string              `json:"body"`
+}
+
+// Invoke calls the handler once with the request read from in, and writes the
+// result as the last line of the output. It returns the process's exit code:
+// 0 with a result, 2 when the request could not be read.
+func (rt *Runtime) Invoke(in io.Reader) int {
+	input, err := io.ReadAll(in)
+	if err != nil {
+		rt.errOut.write(fmt.Sprintf("hivepaas: reading the request: %v", err))
+		return exitUsage
+	}
+	var ir invokeRequest
+	if err := json.Unmarshal(input, &ir); err != nil {
+		rt.errOut.write(fmt.Sprintf("hivepaas: the request is not JSON: %v", err))
+		return exitUsage
+	}
+	body, err := base64.StdEncoding.DecodeString(ir.Body)
+	if err != nil {
+		rt.errOut.write(fmt.Sprintf("hivepaas: the request's body is not base64: %v", err))
+		return exitUsage
+	}
+	req := &hivepaas.Request{
+		Method:  strings.ToUpper(ir.Method),
+		Path:    ir.Path,
+		Query:   url.Values{},
+		Headers: http.Header{},
+		Body:    body,
+	}
+	if req.Method == "" {
+		req.Method = http.MethodGet
+	}
+	if req.Path == "" {
+		req.Path = "/"
+	}
+	for name, values := range ir.Query {
+		req.Query[name] = values
+	}
+	for name, values := range ir.Headers {
+		key := http.CanonicalHeaderKey(name)
+		req.Headers[key] = append(req.Headers[key], values...)
+	}
+	id := requestID(req.Headers.Get("X-Request-Id"))
+
+	var a answer
+	if int64(len(body)) > rt.cfg.MaxBodySize {
+		a = failure(http.StatusRequestEntityTooLarge, "request too large", id, outcomeRequestTooLarge)
+	} else {
+		a = rt.call(context.Background(), id, req, func() {})
+	}
+	rt.logInvocation(id, req.Method, req.Path, a)
+	rt.writeResult(id, a)
+	return exitOK
+}
+
+func (rt *Runtime) writeResult(id string, a answer) {
+	headers := map[string][]string{}
+	for name, values := range a.headers {
+		headers[strings.ToLower(name)] = values
+	}
+	headers["x-request-id"] = []string{id}
+	line, _ := json.Marshal(struct { // strings, numbers and a map of strings always encode
+		Status     int                 `json:"status"`
+		Headers    map[string][]string `json:"headers"`
+		Body       string              `json:"body"`
+		RequestID  string              `json:"requestId"`
+		DurationMs float64             `json:"durationMs"`
+		Outcome    string              `json:"outcome"`
+	}{a.status, headers, base64.StdEncoding.EncodeToString(a.body), id, milliseconds(a.duration), a.outcome})
+	rt.out.writeLast(resultMarker + string(line))
+}
diff --git a/hivepaas/serve/main.go b/hivepaas/serve/main.go
new file mode 100644
index 0000000..04f5165
--- /dev/null
+++ b/hivepaas/serve/main.go
@@ -0,0 +1,85 @@
+package serve
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"os"
+	"os/signal"
+	"strconv"
+	"syscall"
+	"time"
+
+	"github.com/hivepaas/function-runtimes/hivepaas"
+)
+
+const usage = "usage: hivepaas-runtime serve|invoke|health"
+
+// Exit codes: a result, a failure, a command or input that cannot be used.
+const (
+	exitOK     = 0
+	exitFailed = 1
+	exitUsage  = 2
+)
+
+const healthTimeout = 3 * time.Second
+
+// Main runs h as the command line asks, and exits.
+func Main(h hivepaas.HandlerFunc) {
+	os.Exit(run(h, os.Args[1:], os.Getenv, os.Stdin, os.Stdout, os.Stderr))
+}
+
+func run(h hivepaas.HandlerFunc, args []string, getenv func(string) string,
+	stdin io.Reader, stdout, stderr io.Writer,
+) int {
+	command := "serve"
+	if len(args) > 0 {
+		command = args[0]
+	}
+	if command != "serve" && command != "invoke" && command != "health" {
+		_, _ = fmt.Fprintln(stderr, usage)
+		return exitUsage
+	}
+	cfg, err := LoadConfig(getenv)
+	if err != nil {
+		_, _ = fmt.Fprintf(stderr, "hivepaas: %v\n", err)
+		return exitUsage
+	}
+	switch command {
+	case "invoke":
+		return New(h, cfg, stdout, stderr).Invoke(stdin)
+	case "health":
+		return Health(cfg, stderr)
+	}
+	listener, err := net.Listen("tcp", ":"+strconv.Itoa(cfg.Port))
+	if err != nil {
+		_, _ = fmt.Fprintf(stderr, "hivepaas: %v\n", err)
+		return exitFailed
+	}
+	ctx, stop := signal.NotifyContext(context.Background(), syscall.SIGTERM, os.Interrupt)
+	defer stop()
+	if err := New(h, cfg, stdout, stderr).Serve(ctx, listener); err != nil {
+		_, _ = fmt.Fprintf(stderr, "hivepaas: %v\n", err)
+		return exitFailed
+	}
+	return exitOK
+}
+
+// Health asks the server on this container for its health: 0 when it is
+// healthy, 1 otherwise, with the reason on errOut.
+func Health(cfg Config, errOut io.Writer) int {
+	client := &http.Client{Timeout: healthTimeout}
+	resp, err := client.Get(fmt.Sprintf("http://127.0.0.1:%d/_hivepaas/health", cfg.Port))
+	if err != nil {
+		_, _ = fmt.Fprintf(errOut, "hivepaas: %v\n", err)
+		return exitFailed
+	}
+	_ = resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		_, _ = fmt.Fprintf(errOut, "hivepaas: health is %s\n", resp.Status)
+		return exitFailed
+	}
+	return exitOK
+}
diff --git a/hivepaas/serve/serve.go b/hivepaas/serve/serve.go
new file mode 100644
index 0000000..a899133
--- /dev/null
+++ b/hivepaas/serve/serve.go
@@ -0,0 +1,358 @@
+// Package serve runs a Go function's handler as the contract says: an HTTP
+// server, or one call read on standard input. The runtime's build compiles a
+// main that calls Main; see CONTRACT.md in this repository.
+package serve
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"regexp"
+	"runtime/debug"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/hivepaas/function-runtimes/hivepaas"
+)
+
+const (
+	outcomeOK               = "ok"
+	outcomeError            = "error"
+	outcomeTimeout          = "timeout"
+	outcomeThrottled        = "throttled"
+	outcomeRequestTooLarge  = "request_too_large"
+	outcomeResponseTooLarge = "response_too_large"
+)
+
+const (
+	// idleTimeout is longer than a proxy in front keeps an idle connection
+	// (Traefik: 90s), so that the proxy, not the function, closes it.
+	idleTimeout       = 5 * time.Minute
+	readHeaderTimeout = 10 * time.Second
+	requestIDBytes    = 16
+)
+
+var (
+	errHandlerPanicked  = errors.New("the handler panicked")
+	errStatusOutOfRange = errors.New("the response's status is not from 200 to 599")
+	errResponseTooLarge = errors.New("the response's body is larger than HP_FN_MAX_BODY_SIZE")
+)
+
+var requestIDPattern = regexp.MustCompile(`^[A-Za-z0-9._-]{1,128}$`)
+
+// Runtime runs one handler under the configured limits.
+type Runtime struct {
+	handler hivepaas.HandlerFunc
+	cfg     Config
+	out     *lineWriter
+	errOut  *lineWriter
+	slots   chan struct{}
+}
+
+// New is a runtime for h. Its log goes to out, its errors to errOut.
+func New(h hivepaas.HandlerFunc, cfg Config, out, errOut io.Writer) *Runtime {
+	return &Runtime{
+		handler: h,
+		cfg:     cfg,
+		out:     &lineWriter{w: out},
+		errOut:  &lineWriter{w: errOut},
+		slots:   make(chan struct{}, cfg.MaxConcurrency),
+	}
+}
+
+// Serve answers on l until ctx ends, then waits for the running calls, at
+// most for one timeout, and returns.
+func (rt *Runtime) Serve(ctx context.Context, l net.Listener) error {
+	server := &http.Server{
+		Handler:           rt,
+		ReadHeaderTimeout: readHeaderTimeout,
+		IdleTimeout:       idleTimeout,
+	}
+	served := make(chan error, 1)
+	go func() { served <- server.Serve(l) }()
+	select {
+	case err := <-served:
+		return err
+	case <-ctx.Done():
+	}
+	shutdownCtx, cancel := context.WithTimeout(context.WithoutCancel(ctx), rt.cfg.Timeout)
+	defer cancel()
+	if err := server.Shutdown(shutdownCtx); err != nil {
+		return fmt.Errorf("stopping: %w", err)
+	}
+	if err := <-served; !errors.Is(err, http.ErrServerClosed) {
+		return err
+	}
+	return nil
+}
+
+// ServeHTTP answers one request.
+func (rt *Runtime) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	id := requestID(r.Header.Get("X-Request-Id"))
+	path := r.URL.EscapedPath()
+	if strings.HasPrefix(path, "/_hivepaas/") {
+		rt.serveOwnPath(w, path, id)
+		return
+	}
+	method := strings.ToUpper(r.Method)
+	logged := func(a answer) {
+		rt.logInvocation(id, method, path, a)
+		writeAnswer(w, id, a)
+	}
+
+	if r.ContentLength > rt.cfg.MaxBodySize {
+		logged(failure(http.StatusRequestEntityTooLarge, "request too large", id, outcomeRequestTooLarge))
+		return
+	}
+	body, err := rt.readBody(w, r)
+	if err != nil {
+		dropConnection(w) // the client went away, or sends too slowly: not a call
+		return
+	}
+	if int64(len(body)) > rt.cfg.MaxBodySize {
+		logged(failure(http.StatusRequestEntityTooLarge, "request too large", id, outcomeRequestTooLarge))
+		return
+	}
+
+	select {
+	case rt.slots <- struct{}{}:
+	default:
+		a := failure(http.StatusTooManyRequests, "too many requests", id, outcomeThrottled)
+		a.headers.Set("Retry-After", "1")
+		logged(a)
+		return
+	}
+	headers := r.Header.Clone()
+	headers.Set("Host", r.Host) // net/http takes it out of the headers
+	req := &hivepaas.Request{Method: method, Path: path, Query: r.URL.Query(), Headers: headers, Body: body}
+	// A call outlives its client: only its timeout ends it.
+	logged(rt.call(context.WithoutCancel(r.Context()), id, req, func() { <-rt.slots }))
+}
+
+// dropConnection closes the request's connection without an answer. A panic
+// with http.ErrAbortHandler alone would not do: the server would first read
+// what is left of the body, with no deadline.
+func dropConnection(w http.ResponseWriter) {
+	if conn, _, err := http.NewResponseController(w).Hijack(); err == nil {
+		_ = conn.Close()
+		return
+	}
+	panic(http.ErrAbortHandler)
+}
+
+// readBody reads at most one byte over the limit, within one timeout.
+func (rt *Runtime) readBody(w http.ResponseWriter, r *http.Request) ([]byte, error) {
+	rc := http.NewResponseController(w)
+	_ = rc.SetReadDeadline(time.Now().Add(rt.cfg.Timeout))
+	defer func() { _ = rc.SetReadDeadline(time.Time{}) }()
+	body, err := io.ReadAll(io.LimitReader(r.Body, rt.cfg.MaxBodySize+1))
+	if err != nil {
+		return nil, fmt.Errorf("reading the request's body: %w", err)
+	}
+	return body, nil
+}
+
+func (rt *Runtime) serveOwnPath(w http.ResponseWriter, path, id string) {
+	if path == "/_hivepaas/health" {
+		writeAnswer(w, id, jsonAnswer(http.StatusOK, map[string]string{"status": "ok"}))
+		return
+	}
+	writeAnswer(w, id, jsonAnswer(http.StatusNotFound, map[string]string{"error": "not found"}))
+}
+
+// answer is what a call answers, and how it went.
+type answer struct {
+	status   int
+	headers  http.Header
+	body     []byte
+	outcome  string
+	duration time.Duration
+}
+
+type handled struct {
+	resp *hivepaas.Response
+	err  error
+}
+
+// call runs the handler on req within the timeout. release runs when the
+// handler returns, which may be after the call was answered.
+func (rt *Runtime) call(parent context.Context, id string, req *hivepaas.Request, release func()) answer {
+	start := time.Now()
+	ctx, cancel := context.WithTimeout(parent, rt.cfg.Timeout)
+	defer cancel()
+	ctx = hivepaas.WithInvocation(ctx, id, func(msg string) {
+		rt.out.writeJSON(map[string]string{"hp": "log", "requestId": id, "msg": msg})
+	})
+
+	done := make(chan handled, 1)
+	go func() {
+		defer release()
+		done <- rt.runHandler(ctx, req)
+	}()
+	var h handled
+	select {
+	case h = <-done:
+	case <-ctx.Done():
+		select {
+		case h = <-done: // it returned as the timeout came
+		default:
+			a := failure(http.StatusGatewayTimeout, "timeout", id, outcomeTimeout)
+			a.duration = time.Since(start)
+			return a
+		}
+	}
+	a := rt.respond(id, h)
+	a.duration = time.Since(start)
+	return a
+}
+
+func (rt *Runtime) runHandler(ctx context.Context, req *hivepaas.Request) (h handled) {
+	defer func() {
+		if p := recover(); p != nil {
+			h = handled{err: fmt.Errorf("%w: %v\n%s", errHandlerPanicked, p, debug.Stack())}
+		}
+	}()
+	resp, err := rt.handler(ctx, req)
+	return handled{resp: resp, err: err}
+}
+
+// respond turns what the handler returned into the answer.
+func (rt *Runtime) respond(id string, h handled) answer {
+	if h.err != nil {
+		rt.callFailed(id, h.err)
+		return failure(http.StatusInternalServerError, "internal error", id, outcomeError)
+	}
+	if h.resp == nil {
+		return answer{status: http.StatusNoContent, headers: http.Header{}, outcome: outcomeOK}
+	}
+	status := h.resp.Status
+	if status == 0 {
+		status = http.StatusOK
+	}
+	if status < 200 || status > 599 {
+		rt.callFailed(id, fmt.Errorf("%w: %d", errStatusOutOfRange, status))
+		return failure(http.StatusInternalServerError, "internal error", id, outcomeError)
+	}
+	if size := int64(len(h.resp.Body)); size > rt.cfg.MaxBodySize {
+		rt.callFailed(id, fmt.Errorf("%w: %d bytes, over %d", errResponseTooLarge, size, rt.cfg.MaxBodySize))
+		return failure(http.StatusInternalServerError, "internal error", id, outcomeResponseTooLarge)
+	}
+	headers := http.Header{}
+	for name, values := range h.resp.Headers {
+		key := http.CanonicalHeaderKey(name)
+		headers[key] = append(headers[key], values...)
+	}
+	body := h.resp.Body
+	if !bodyAllowed(status) {
+		body = nil
+	}
+	if len(body) > 0 && headers.Get("Content-Type") == "" {
+		headers.Set("Content-Type", "application/octet-stream")
+	}
+	return answer{status: status, headers: headers, body: body, outcome: outcomeOK}
+}
+
+func (rt *Runtime) callFailed(id string, err error) {
+	rt.errOut.write(fmt.Sprintf("hivepaas: call %s failed: %v", id, err))
+}
+
+func (rt *Runtime) logInvocation(id, method, path string, a answer) {
+	rt.out.writeJSON(struct {
+		HP         string  `json:"hp"`
+		RequestID  string  `json:"requestId"`
+		Method     string  `json:"method"`
+		Path       string  `json:"path"`
+		Status     int     `json:"status"`
+		DurationMs float64 `json:"durationMs"`
+		Outcome    string  `json:"outcome"`
+	}{"invocation", id, method, path, a.status, milliseconds(a.duration), a.outcome})
+}
+
+// failure is an answer the runtime makes itself.
+func failure(status int, message, id, outcome string) answer {
+	a := jsonAnswer(status, map[string]string{"error": message, "requestId": id})
+	a.outcome = outcome
+	return a
+}
+
+func jsonAnswer(status int, v map[string]string) answer {
+	body, _ := json.Marshal(v) // a map of strings always encodes
+	return answer{status: status, headers: http.Header{"Content-Type": {"application/json"}}, body: body}
+}
+
+func writeAnswer(w http.ResponseWriter, id string, a answer) {
+	header := w.Header()
+	for name, values := range a.headers {
+		header[name] = values
+	}
+	header.Del("Transfer-Encoding")
+	header.Set("X-Request-Id", id)
+	if bodyAllowed(a.status) {
+		header.Set("Content-Length", strconv.Itoa(len(a.body)))
+	} else {
+		header.Del("Content-Length")
+	}
+	w.WriteHeader(a.status)
+	if len(a.body) > 0 {
+		_, _ = w.Write(a.body)
+	}
+}
+
+func bodyAllowed(status int) bool {
+	return status != http.StatusNoContent && status != http.StatusNotModified
+}
+
+// requestID is the request's own id when the contract accepts it, else a new one.
+func requestID(sent string) string {
+	if requestIDPattern.MatchString(sent) {
+		return sent
+	}
+	b := make([]byte, requestIDBytes)
+	_, _ = rand.Read(b)
+	return hex.EncodeToString(b)
+}
+
+// milliseconds is d in milliseconds, to the microsecond.
+func milliseconds(d time.Duration) float64 {
+	return float64(d.Microseconds()) / float64(time.Millisecond/time.Microsecond)
+}
+
+// lineWriter writes whole lines, one at a time, until it is closed.
+type lineWriter struct {
+	mu     sync.Mutex
+	w      io.Writer
+	closed bool
+}
+
+func (lw *lineWriter) write(line string) {
+	lw.mu.Lock()
+	defer lw.mu.Unlock()
+	if !lw.closed {
+		_, _ = io.WriteString(lw.w, line+"\n")
+	}
+}
+
+func (lw *lineWriter) writeJSON(v any) {
+	line, err := json.Marshal(v)
+	if err == nil {
+		lw.write(string(line))
+	}
+}
+
+// writeLast writes line, and nothing after it.
+func (lw *lineWriter) writeLast(line string) {
+	lw.mu.Lock()
+	defer lw.mu.Unlock()
+	if !lw.closed {
+		_, _ = io.WriteString(lw.w, line+"\n")
+		lw.closed = true
+	}
+}
