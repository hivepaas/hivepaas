{
  "command":"mariadb ${CMD_CONN_ARGS} ${CMD_OPTS_ARGS}",
  "link":"https://mariadb.com/kb/en/mariadb-command-line-client/",
  "desc":"Read SQL script stream from stdin and execute it into a MariaDB database",
  "envVars":[
    {"k":"MYSQL_PWD", "v":"${HIVEPAAS_PASSWORD}"}
  ],
  "argGroups":[
    {
      "enabled":true,
      "exportEnv":"CMD_CONN_ARGS",
      "separator":"=",
      "args":[
        {"use":true, "name":"--host", "value":"localhost"},
        {"use":true, "name":"--port", "value":"${HIVEPAAS_PORT}"},
        {"use":true, "name":"--user", "value":"${HIVEPAAS_USER}"},
        {"use":true, "name":"--database", "value":"${HIVEPAAS_DATABASE}"}
      ]
    },
    {
      "enabled":true,
      "exportEnv":"CMD_OPTS_ARGS",
      "separator":"=",
      "args":[
        {"use":true, "name":"--max-allowed-packet", "value":"512M"},
        {"use":true, "name":"--binary-mode"},
        {"use":false, "name":"--verbose"}
      ]
    }
  ]
}
