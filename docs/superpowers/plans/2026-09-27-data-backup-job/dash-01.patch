+                                templateEnv={env}
+                                configureTemplatesLink={configureTemplatesLink}
+                                readOnly={readOnly}
+                                showArgGroups
+                            />
+                        )}
+
+                        <ContentBlock label="Repository">
+                            <div className="flex flex-col gap-6">
