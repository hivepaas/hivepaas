{
  "command":"sqlcmd ${CMD_CONN_ARGS} ${CMD_OPTS_ARGS}",
  "envVars":[
    {"k":"SQLCMDPASSWORD", "v":"${HIVEPAAS_PASSWORD}"}
  ],
  "argGroups":[
    {
      "enabled":true,
      "exportEnv":"CMD_CONN_ARGS",
      "separator":" ",
      "args":[
        {"use":true, "name":"-S", "value":"localhost,${HIVEPAAS_PORT}"},
        {"use":true, "name":"-U", "value":"${HIVEPAAS_USER}"},
        {"use":true, "name":"-C"}
      ]
    },
    {
      "enabled":true,
      "exportEnv":"CMD_OPTS_ARGS",
      "separator":" ",
      "args":[
        {"use":true, "name":"-Q", "value":"RESTORE DATABASE [${HIVEPAAS_DATABASE}] FROM DISK = N'/var/opt/mssql/data/backup.bak' WITH REPLACE"}
      ]
    }
  ]
}
