{
  "command":"mongosh ${CMD_CONN_ARGS} ${CMD_OPTS_ARGS}",
  "link":"https://www.mongodb.com/docs/manual/reference/command/serverStatus/",
  "desc":"Inspect MongoDB server status, active connections, and memory usage",
  "envVars":[],
  "argGroups":[
    {
      "enabled":true,
      "exportEnv":"CMD_CONN_ARGS",
      "separator":"=",
      "args":[
        {"use":true, "name":"--host", "value":"localhost"},
        {"use":true, "name":"--port", "value":"${HIVEPAAS_PORT}"},
        {"use":true, "name":"--username", "value":"${HIVEPAAS_USER}"},
        {"use":true, "name":"--password", "value":"${HIVEPAAS_PASSWORD}"},
        {"use":true, "name":"--authenticationDatabase", "value":"admin"},
        {"use":true, "name":"--quiet"}
      ]
    },
    {
      "enabled":true,
      "exportEnv":"CMD_OPTS_ARGS",
      "separator":" ",
      "args":[
        {"use":true, "name":"--eval", "value":"JSON.stringify(db.serverStatus({connections:1, mem:1, opcounters:1}))"}
      ]
    }
  ]
}
