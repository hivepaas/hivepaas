+                    disabled={isPending}
+                    onClick={onDone}
+                >
+                    Cancel
+                </Button>
+                <Button
+                    variant="destructive"
+                    isLoading={isPending}
+                    disabled={!kind || problems.length > 0 || !confirmed}
+                    onClick={submit}
+                >
+                    Restore
+                </Button>
+            </SheetFooter>
+        </>
+    );
+}
