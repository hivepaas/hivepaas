{
  "command":"sqlite3 ${CMD_OPTS_ARGS} ${CMD_OUTPUT_ARGS}",
  "link":"https://www.sqlite.org/cli.html#vacuum",
  "desc":"Create a consistent live backup of SQLite database to a local file",
  "envVars":[],
  "argGroups":[
    {
      "enabled":true,
      "exportEnv":"CMD_OPTS_ARGS",
      "separator":" ",
      "args":[
        {"use":true, "name":"/data/database.sqlite"}
      ]
    },
    {
      "enabled":true,
      "exportEnv":"CMD_OUTPUT_ARGS",
      "separator":" ",
      "args":[
        {"use":true, "name":".backup '/tmp/database_backup.sqlite'"}
      ]
    }
  ]
}
