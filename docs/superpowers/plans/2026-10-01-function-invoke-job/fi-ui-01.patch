+                                            disabled={readOnly}
+                                        />
+                                        <FieldError errors={[errors.timeout]} />
+                                    </Field>
+                                </InfoBlock>
+
+                                <InfoBlock
+                                    title="Retry"
+                                    titleWidth={TITLE_WIDTH}
+                                >
+                                    <div className="flex flex-wrap items-start gap-4">
+                                        <Field className="w-auto">
+                                            <Input
+                                                ref={maxRetry.ref}
+                                                name={maxRetry.name}
+                                                type="number"
+                                                inputMode="numeric"
+                                                min={0}
+                                                value={maxRetry.value ?? ""}
