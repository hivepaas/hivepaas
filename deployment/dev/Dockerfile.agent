############################################################
# Build backend
FROM golang:1.26-alpine AS builder

RUN apk update && \
    apk add --no-cache -U tzdata make git build-base ca-certificates && \
    rm -rf /var/cache/apk/*

# ENV vars
ENV CGO_ENABLED=0

# Move to working directory /build
WORKDIR /build

# Copy the code into the container
COPY . .

# Copy and download dependency using go mod
RUN make mod

# Build the agent application
RUN go build -o hivepaas-agent ./hivepaas_app/cmd/agent/...

############################################################
# Build a small image
FROM alpine:3.23
WORKDIR /hivepaas

ARG TARGETARCH

RUN apk update && \
    apk add --no-cache ca-certificates curl make openssl postgresql-client git git-lfs openssh-client rsync zstd lz4 docker-cli docker-cli-buildx acl && \
    ARCH="$(case "${TARGETARCH}" in "arm64") echo "arm64" ;; *) echo "x86_64" ;; esac)" && \
    curl -sSL "https://github.com/railwayapp/railpack/releases/download/v0.35.0/railpack-v0.35.0-${ARCH}-unknown-linux-musl.tar.gz" | tar -xz -C /usr/local/bin && \
    chmod +x /usr/local/bin/railpack && \
    git lfs install --system && \
    apk del curl && \
    rm -rf /var/cache/apk/*

# Copy compiled agent binary and base configurations
COPY --from=builder /build/hivepaas-agent .
COPY --from=builder /build/config ./config

# Command to run
CMD ["./hivepaas-agent"]
