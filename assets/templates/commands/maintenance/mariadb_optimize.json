{
  "command":"mariadb-check ${CMD_CONN_ARGS} ${CMD_OPTS_ARGS}",
  "link":"https://mariadb.com/kb/en/mariadb-check/",
  "desc":"Optimize tables and defragment data files in MariaDB",
  "envVars":[
    {"k":"MYSQL_PWD", "v":"${HIVEPAAS_PASSWORD}"}
  ],
  "argGroups":[
    {
      "enabled":true,
      "exportEnv":"CMD_CONN_ARGS",
      "separator":"=",
      "args":[
        {"use":true, "name":"--host", "value":"localhost"},
        {"use":true, "name":"--port", "value":"${HIVEPAAS_PORT}"},
        {"use":true, "name":"--user", "value":"${HIVEPAAS_USER}"}
      ]
    },
    {
      "enabled":true,
      "exportEnv":"CMD_OPTS_ARGS",
      "separator":" ",
      "args":[
        {"use":true, "name":"--optimize"},
        {"use":true, "name":"--databases", "value":"${HIVEPAAS_DATABASE}"}
      ]
    }
  ]
}
