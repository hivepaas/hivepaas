{
  "command":"psql ${CMD_CONN_ARGS} ${CMD_OPTS_ARGS}",
  "link":"https://www.postgresql.org/docs/current/sql-createextension.html",
  "desc":"Enable popular PostgreSQL extensions including uuid-ossp, pgcrypto, and vector",
  "envVars":[
    {"k":"PGPASSWORD", "v":"${HIVEPAAS_PASSWORD}"}
  ],
  "argGroups":[
    {
      "enabled":true,
      "exportEnv":"CMD_CONN_ARGS",
      "separator":"=",
      "args":[
        {"use":true, "name":"--host", "value":"localhost"},
        {"use":true, "name":"--port", "value":"${HIVEPAAS_PORT}"},
        {"use":true, "name":"--username", "value":"${HIVEPAAS_USER}"},
        {"use":true, "name":"--dbname", "value":"${HIVEPAAS_DATABASE}"},
        {"use":true, "name":"--no-password"}
      ]
    },
    {
      "enabled":true,
      "exportEnv":"CMD_OPTS_ARGS",
      "separator":" ",
      "args":[
        {"use":true, "name":"-c", "value":"CREATE EXTENSION IF NOT EXISTS \"uuid-ossp\"; CREATE EXTENSION IF NOT EXISTS \"pgcrypto\"; CREATE EXTENSION IF NOT EXISTS \"pg_stat_statements\"; CREATE EXTENSION IF NOT EXISTS \"vector\";"}
      ]
    }
  ]
}
