+service RepoServerService {
+  // RepoServer runs a kopia repository server for as long as the stream is open.
+  // The client sends one request; the agent answers once the server listens, and
+  // ends the stream with an error when the server exits.
+  rpc RepoServer(stream RepoServerReq) returns (stream RepoServerResp);
+}
