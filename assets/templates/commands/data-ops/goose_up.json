{
  "command":"goose ${CMD_OPTS_ARGS}",
  "link":"https://github.com/pressly/goose",
  "desc":"Apply all available migrations using goose",
  "envVars":[],
  "argGroups":[
    {
      "enabled":true,
      "exportEnv":"CMD_OPTS_ARGS",
      "separator":" ",
      "args":[
        {"use":true, "name":"-dir", "value":"/migrations"},
        {"use":true, "name":"postgres"},
        {"use":true, "name":"${DATABASE_URL}"},
        {"use":true, "name":"up"}
      ]
    }
  ]
}
